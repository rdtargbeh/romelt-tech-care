# ================================================================
# ROMELT TECHCARE — FRONTEND ENVIRONMENT TEMPLATE
# ================================================================
#
# Purpose:
# Documents every environment variable required by the Romelt
# TechCare frontend.
#
# Usage:
# Copy this file to `.env.local`, `.env.development`, or another
# appropriate Vite environment file.
#
# Security:
# Variables beginning with VITE_ are visible in the browser.
# Never place passwords, private keys, database credentials,
# access tokens, or other secrets in this file.
# ================================================================

# Public website URL without a trailing slash.
VITE_SITE_URL=http://localhost:5173

# Spring Boot API base URL without a trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supported values:
# development
# test
# staging
# production
VITE_APP_ENV=development

# Enables frontend diagnostic logging.
VITE_ENABLE_DEBUG_LOGGING=true

# Enables real contact-form submission to the backend.
VITE_ENABLE_CONTACT_API=true

# Enables real booking-form submission to the backend.
VITE_ENABLE_BOOKING_API=true