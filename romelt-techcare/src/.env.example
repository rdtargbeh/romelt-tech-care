
# ================================================================
# ROMELT TECHCARE — FRONTEND ENVIRONMENT TEMPLATE
# ================================================================
#
# Purpose:
# Documents every environment variable required by the public
# Romelt TechCare frontend.
#
# Usage:
# Copy this file to `.env.local` for local development.
#
# Never commit real secrets, private keys, passwords, or production
# credentials to the repository.
# ================================================================

# Public website URL without a trailing slash.
VITE_SITE_URL=http://localhost:5173

# Spring Boot API base URL without a trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Current application environment.
VITE_APP_ENV=development

# Enables frontend development logging.
VITE_ENABLE_DEBUG_LOGGING=true

# Enables real contact-form API submission.
VITE_ENABLE_CONTACT_API=false

# Enables real booking-form API submission.
VITE_ENABLE_BOOKING_API=false