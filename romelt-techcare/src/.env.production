# ================================================================
# ROMELT TECHCARE — PRODUCTION ENVIRONMENT
# ================================================================
#
# Purpose:
# Connects the deployed React website to the deployed Spring Boot API.
#
# Important:
# Confirm that both production domains are active before deployment.
# ================================================================

VITE_SITE_URL=https://www.romelttechcare.com

VITE_API_BASE_URL=https://api.romelttechcare.com/api/v1

VITE_APP_ENV=production

VITE_ENABLE_DEBUG_LOGGING=false

VITE_ENABLE_CONTACT_API=true

VITE_ENABLE_BOOKING_API=true